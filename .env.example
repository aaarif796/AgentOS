AGENTOS_ENV=development
AGENTOS_DATABASE_URL=sqlite+aiosqlite:///./agentos.db
AGENTOS_WORKSPACE=.
AGENTOS_DEFAULT_MODEL=openai/gpt-4o-mini
AGENTOS_FALLBACK_MODELS=anthropic/claude-3-5-haiku-latest,gemini/gemini-2.0-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AGENTOS_LOG_LEVEL=INFO

# ---- model policy: prefer free/local models, fall back to paid on failure ----
AGENTOS_MODEL_POLICY=local-first         # local-first | free-first | hybrid | paid-first | free-only
AGENTOS_OLLAMA_URL=http://127.0.0.1:11434
# free providers (all OpenAI-compatible) - one key unlocks the tier
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
# convenience: set one of these to point an OpenAI/Anthropic/Gemini compatible
# gateway at any custom/free base url (optional)
AGENTOS_FREE_MODELS=groq/llama-3.3-70b-versatile,openrouter/deepseek/deepseek-chat-v3-2:free
AGENTOS_LOCAL_MODELS=ollama/llama3.2:3b,ollama/llama3.1:8b,ollama/qwen3:8b,ollama/qwen2.5:14b,ollama/qwen2.5-coder:7b,ollama/mistral:7b,ollama/mistral-nemo:12b,ollama/gemma3:12b,ollama/gemma3:4b,ollama/phi4-mini,ollama/deepseek-r1:8b

# ---- verify / budget guardrails ----
AGENTOS_TASK_TOKEN_BUDGET=200000
AGENTOS_MAX_ATTEMPTS=3
AGENTOS_MAX_TOOL_STEPS=8
AGENTOS_VERIFY_LLM_REVIEW=true
AGENTOS_VERIFY_WITH_TOOLS=true
AGENTOS_VERIFY_ON_ERROR=fail_closed      # fail_closed | fail_open
AGENTOS_MODEL_COOLDOWN_SECONDS=60
AGENTOS_MODEL_MAX_CONSECUTIVE_FAILURES=3

# ---- memory ----
AGENTOS_MEMORY_ENABLED=true
AGENTOS_MEMORY_MAX_SHORT_TERM=40
AGENTOS_MEMORY_TOP_K=5

# ---- books / slides ----
AGENTOS_BOOK_OUTPUT_DIR=books
AGENTOS_BOOK_MAX_CHAPTER_ATTEMPTS=3
AGENTOS_BOOK_REQUIRE_APPROVAL=false
AGENTOS_SLIDES_OUTPUT_DIR=slides
AGENTOS_SLIDES_MAX_SECTION_ATTEMPTS=3
AGENTOS_SCRAPE_MAX_BYTES=300000
AGENTOS_SCRAPE_TIMEOUT=20
AGENTOS_SCRAPE_ALLOW_PRIVATE=false
